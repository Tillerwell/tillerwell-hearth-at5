# Applied after esp-matter's examples/light/sdkconfig.defaults and its
# sdkconfig.defaults.c6_thread. Only our differences live here.
CONFIG_AUTOTERM_VARIANT_MATTER_THREAD=y
CONFIG_AUTOTERM_VARIANT_WIFI=n
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# esp-matter's light example switches off every cluster a light doesn't use
CONFIG_SUPPORT_THERMOSTAT_CLUSTER=y
CONFIG_SUPPORT_TEMPERATURE_MEASUREMENT_CLUSTER=y
CONFIG_SUPPORT_BOOLEAN_STATE_CLUSTER=y
CONFIG_SUPPORT_ON_OFF_CLUSTER=y

# our own USB console replaces the CHIP shell (two REPLs cannot share the port)
CONFIG_ENABLE_CHIP_SHELL=n

# thermostat + temperature sensor + plug + contact sensor + root node + spares
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=8
