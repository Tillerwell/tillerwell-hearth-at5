# Common settings.
CONFIG_IDF_TARGET="esp32c6"
CONFIG_FREERTOS_HZ=1000
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# The console lives on the USB port so UART0 is free for the controller side.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Keep the relay alive: never let a stuck network task reset the chip for no reason
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

CONFIG_LWIP_MAX_SOCKETS=16

# Back on the network sooner after a restart or update. DHCP asks the router for the address it had last time (one
# round trip fewer) and skips the ARP probe of the offered address (about a second).
CONFIG_LWIP_DHCP_RESTORE_LAST_IP=y
CONFIG_LWIP_DHCP_DOES_NOT_CHECK_OFFERED_IP=y
# No ROM banner, and the bootloader only prints warnings
CONFIG_BOOT_ROM_LOG_ALWAYS_OFF=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
